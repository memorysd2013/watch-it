{
  "name": "watch-it",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "setup-env": "node setup-env.cjs",
    "setup-env:local": "node setup-env.cjs local",
    "setup-env:staging": "node setup-env.cjs staging",
